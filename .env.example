# Copy to .env (local dev only, never commit). Secrets also backed up in 1Password.
DATABASE_URL=postgresql://user:pass@localhost:5432/keyhole
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
DATA_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
ADMIN_EMAILS=you@gmail.com
APP_URL=http://localhost:5173
# Canonical prod URL (e.g. https://keyhole.vercel.app). OAuth refuses to run
# on any non-localhost APP_URL that does not equal this (preview isolation).
PROD_APP_URL=
# Per-key daily quota for /api/v1/* (429 past this).
API_KEY_DAILY_LIMIT=2000
TEST_CALENDAR_ID=
